-- ============ ESP ============
local espT = {}
local function removeEsp(m)
    local d = espT[m]; if not d then return end
    if d.hl then pcall(function() d.hl:Destroy() end) end
    if d.bb then pcall(function() d.bb:Destroy() end) end
    espT[m] = nil
end
local function cleanupEsp() for m in pairs(espT) do removeEsp(m) end; espT = {} end

local function createEsp(m, isNpc)
    if espT[m] then return espT[m] end
    if not m or not m.Parent then return nil end
    local col = isNpc and S.ESPNpcColor or S.ESPPlayerColor
    local hl = Instance.new("Highlight")
    hl.Adornee = m; hl.FillColor = col; hl.OutlineColor = col
    hl.FillTransparency = 0.5; hl.OutlineTransparency = 0
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop; hl.Parent = m

    local head = m:FindFirstChild("Head") or m:FindFirstChild("HumanoidRootPart") or m.PrimaryPart
    local bb
    if head then
        bb = Instance.new("BillboardGui")
        bb.Size = UDim2.new(0, 200, 0, 40); bb.StudsOffset = Vector3.new(0, 3, 0)
        bb.AlwaysOnTop = true; bb.LightInfluence = 0; bb.Adornee = head; bb.Parent = head
        local l1 = Instance.new("TextLabel")
        l1.Size = UDim2.new(1, 0, 0.5, 0); l1.BackgroundTransparency = 1
        l1.TextColor3 = col; l1.TextStrokeTransparency = 0; l1.TextStrokeColor3 = Color3.new(0,0,0)
        l1.Font = Enum.Font.GothamBold; l1.TextSize = 14; l1.Parent = bb
        local l2 = Instance.new("TextLabel")
        l2.Size = UDim2.new(1, 0, 0.5, 0); l2.Position = UDim2.new(0, 0, 0.5, 0)
        l2.BackgroundTransparency = 1; l2.TextColor3 = Color3.fromRGB(255,255,255)
        l2.TextStrokeTransparency = 0; l2.TextStrokeColor3 = Color3.new(0,0,0)
        l2.Font = Enum.Font.Gotham; l2.TextSize = 11; l2.Parent = bb
    end
    espT[m] = {hl = hl, bb = bb, isNpc = isNpc}
    return espT[m]
end

local function updateEsp()
    if not S.ESPEnabled then return end
    local c = player.Character
    if not c then return end
    local mr = c:FindFirstChild("HumanoidRootPart")
    if not mr then return end
    local myPos = mr.Position
    local all = (S.ESPMode == "All")

    if S.ESPPlayers then
        local found = {}
        if all then
            for _, pl in ipairs(Players:GetPlayers()) do
                if pl ~= player and pl.Character and pl.Character ~= c then
                    local h = pl.Character:FindFirstChildOfClass("Humanoid")
                    local r = pl.Character:FindFirstChild("HumanoidRootPart")
                    if h and h.Health > 0 and r then
                        local d = (r.Position - myPos).Magnitude
                        if d <= S.ESPMaxDist then
                            found[pl.Character] = d
                            local data = createEsp(pl.Character, false)
                            if data and data.bb then
                                local l1 = data.bb:FindFirstChildWhichIsA("TextLabel")
                                local l2 = data.bb:GetChildren()[2]
                                if l1 then l1.Text = S.ESPShowName and pl.Name or "Player" end
                                if l2 then l2.Text = S.ESPShowDist and (math.floor(d) .. " studs") or "" end
                            end
                        end
                    end
                end
            end
        else
            local np, nd = nil, S.ESPMaxDist
            for _, pl in ipairs(Players:GetPlayers()) do
                if pl ~= player and pl.Character and pl.Character ~= c then
                    local h = pl.Character:FindFirstChildOfClass("Humanoid")
                    local r = pl.Character:FindFirstChild("HumanoidRootPart")
                    if h and h.Health > 0 and r then
                        local d = (r.Position - myPos).Magnitude
                        if d < nd then nd = d; np = pl.Character end
                    end
                end
            end
            if np then
                found[np] = nd
                local data = createEsp(np, false)
                if data and data.bb then
                    local l1 = data.bb:FindFirstChildWhichIsA("TextLabel")
                    local l2 = data.bb:GetChildren()[2]
                    if l1 then l1.Text = S.ESPShowName and np.Name or "Player" end
                    if l2 then l2.Text = S.ESPShowDist and (math.floor(nd) .. " studs") or "" end
                end
            end
        end
        for m, d in pairs(espT) do
            if not d.isNpc and not found[m] then removeEsp(m) end
        end
    else
        for m, d in pairs(espT) do if not d.isNpc then removeEsp(m) end end
    end

    if S.ESPNpc then
        local found = {}
        local conts = {workspace}
        for _, ch in ipairs(workspace:GetChildren()) do
            if ch:IsA("Folder") or ch:IsA("Model") then
                table.insert(conts, ch)
                for _, s in ipairs(ch:GetChildren()) do
                    if s:IsA("Folder") or s:IsA("Model") then table.insert(conts, s) end
                end
            end
        end
        local seen = {}
        for _, cn in ipairs(conts) do
            if not seen[cn] then
                seen[cn] = true
                for _, o in ipairs(cn:GetChildren()) do
                    if o:IsA("Model") and o ~= c and not seen[o] then
                        local h = o:FindFirstChildOfClass("Humanoid")
                        local r = o:FindFirstChild("HumanoidRootPart")
                        if h and h.Health > 0 and r and not Players:GetPlayerFromCharacter(o) then
                            local d = (r.Position - myPos).Magnitude
                            if d <= S.ESPMaxDist and all then
                                found[o] = d
                                local data = createEsp(o, true)
                                if data and data.bb then
                                    local l1 = data.bb:FindFirstChildWhichIsA("TextLabel")
                                    local l2 = data.bb:GetChildren()[2]
                                    if l1 then l1.Text = "NPC" end
                                    if l2 then l2.Text = S.ESPShowDist and (math.floor(d) .. " studs") or "" end
                                end
                            end
                        end
                    end
                end
            end
        end
        if not all then
            local np, nd = nil, S.ESPMaxDist
            for _, cn in ipairs(conts) do
                for _, o in ipairs(cn:GetChildren()) do
                    if o:IsA("Model") and o ~= c then
                        local h = o:FindFirstChildOfClass("Humanoid")
                        local r = o:FindFirstChild("HumanoidRootPart")
                        if h and h.Health > 0 and r and not Players:GetPlayerFromCharacter(o) then
                            local d = (r.Position - myPos).Magnitude
                            if d < nd then nd = d; np = o end
                        end
                    end
                end
            end
            if np then
                found[np] = nd
                local data = createEsp(np, true)
                if data and data.bb then
                    local l1 = data.bb:FindFirstChildWhichIsA("TextLabel")
                    local l2 = data.bb:GetChildren()[2]
                    if l1 then l1.Text = "NPC" end
                    if l2 then l2.Text = S.ESPShowDist and (math.floor(nd) .. " studs") or "" end
                end
            end
        end
        for m, d in pairs(espT) do if d.isNpc and not found[m] then removeEsp(m) end end
    else
        for m, d in pairs(espT) do if d.isNpc then removeEsp(m) end end
    end
end

task.spawn(function()
    while true do task.wait(0.2); if S.ESPEnabled then pcall(updateEsp) end end
end)

-- ============ AIM ============
local function startAim()
    pcall(function() RunService:UnbindFromRenderStep("AimLoop") end)
    RunService:BindToRenderStep("AimLoop", Enum.RenderPriority.Camera.Value + 1, function(dt)
        if not S.AimEnabled then return end
        if not isAlive() then S.CurrentTarget = nil return end
        if UserInputService.MouseBehavior ~= Enum.MouseBehavior.LockCenter then
            UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
        end
        local t = nil
        local now = tick()
        if S.AimLocked and validT(S.LockedTarget) then t = S.LockedTarget
        else
            if S.AimLocked then S.AimLocked = false; S.LockedTarget = nil end
            if validT(S.CurrentTarget) then
                local d = scrDist(S.CurrentTarget)
                if d < S.KeepFOV then t = S.CurrentTarget; S.TargetLostTime = 0
                elseif now - S.TargetLostTime < S.StickTime then t = S.CurrentTarget
                else S.CurrentTarget = nil end
            end
            if not t then
                t = findTarget(S.AimFOV)
                if t then S.CurrentTarget = t; S.TargetLostTime = 0 end
            elseif not validT(S.CurrentTarget) then S.TargetLostTime = now end
        end
        if not t then return end
        local p = getPart(t, S.AimPart); if not p then return end
        local sp, on = camera:WorldToViewportPoint(p.Position); if not on then return end
        local mp = UserInputService:GetMouseLocation()
        movemouse(math.clamp((sp.X - mp.X) * S.AimSmooth, -30, 30), math.clamp((sp.Y - mp.Y) * S.AimSmooth, -30, 30))
    end)
end

local function stopAim()
    pcall(function() RunService:UnbindFromRenderStep("AimLoop") end)
    S.CurrentTarget = nil
end

-- ============ TRIGGER ============
local trigConn = nil
local function startTrig()
    if trigConn then trigConn:Disconnect() end
    local last = 0
    local phase = "idle"
    trigConn = track(RunService.Heartbeat:Connect(function()
        if not S.TriggerEnabled then return end
        if not isAlive() then phase = "idle" return end
        local t = underCross()
        if not t then phase = "idle" return end
        local c = player.Character
        local h = c and c:FindFirstChildOfClass("Humanoid")
        if not h then return end
        if S.TriggerMode == "spam" then
            local now = tick()
            if now - last >= S.TriggerDelay then clickMouse(); last = now end
        elseif S.TriggerMode == "crit" then
            local st = h:GetState()
            local now = tick()
            if phase == "idle" then
                if st == Enum.HumanoidStateType.Running or st == Enum.HumanoidStateType.RunningNoPhysics or st == Enum.HumanoidStateType.Landed then
                    h.Jump = true; phase = "air"
                end
            elseif phase == "air" then
                if st == Enum.HumanoidStateType.Freefall or st == Enum.HumanoidStateType.FallingDown then
                    local r = c:FindFirstChild("HumanoidRootPart")
                    if r and r.AssemblyLinearVelocity.Y < -0.5 then
                        if underCross() then clickMouse(); phase = "wait"; last = now
                        else phase = "idle" end
                    end
                end
            elseif phase == "wait" then
                if (st == Enum.HumanoidStateType.Landed or st == Enum.HumanoidStateType.Running) and now - last >= S.TriggerCooldown then
                    phase = "idle"
                end
            end
        end
    end))
end

local function stopTrig()
    if trigConn then trigConn:Disconnect(); trigConn = nil end
end

-- ============ VISUAL ============
local function applySky()
    cc.Enabled = S.SkyTintEnabled
    if S.SkyTintEnabled then cc.TintColor = SkyPre[S.SkyTintIndex].color end
end

local function applyFB()
    if S.FullbrightEnabled then
        Lighting.Ambient = Color3.fromRGB(255,255,255)
        Lighting.OutdoorAmbient = Color3.fromRGB(255,255,255)
        Lighting.Brightness = 3
    else
        Lighting.Ambient = ORI.ambient; Lighting.OutdoorAmbient = ORI.outdoorAmbient
        Lighting.Brightness = ORI.brightness
    end
end

local function applyFog()
    if S.FogEnabled then
        Lighting.FogStart = 0; Lighting.FogEnd = 300; Lighting.FogColor = Color3.fromRGB(140,90,200)
    else
        Lighting.FogStart = ORI.fogStart; Lighting.FogEnd = ORI.fogEnd; Lighting.FogColor = ORI.fogColor
    end
end

-- ============ BUILD ============
local buildActive = false
local buildThread = nil

local function spamRMB()
    local vp = camera.ViewportSize
    local x, y = math.floor(vp.X/2), math.floor(vp.Y/2)
    pcall(function()
        if mouse2press and mouse2release then
            mouse2press(); task.wait(0.005); mouse2release()
        elseif VIM then
            VIM:SendMouseButtonEvent(x, y, 1, true, game, 1)
            task.wait(0.005)
            VIM:SendMouseButtonEvent(x, y, 1, false, game, 1)
        end
    end)
end

local function startBuild()
    if buildActive then return end
    if not isAlive() then return end
    buildActive = true
    buildThread = task.spawn(function()
        while buildActive do spamRMB(); task.wait(S.BuildDelay) end
    end)
end

local function stopBuild()
    if not buildActive then return end
    buildActive = false
    if buildThread then pcall(function() task.cancel(buildThread) end); buildThread = nil end
end

