local function createModule(order, name, hk, builders)
    local sh = #builders * 28 + 8
    local mod = Instance.new("Frame")
    mod.Size = UDim2.new(1, 0, 0, 32); mod.BackgroundColor3 = C.btn
    mod.BorderSizePixel = 0; mod.LayoutOrder = order
    mod.AutomaticSize = Enum.AutomaticSize.Y; mod.ClipsDescendants = false
    mod.Parent = cont
    Instance.new("UICorner", mod).CornerRadius = UDim.new(0, 8)
    local stroke = Instance.new("UIStroke")
    stroke.Color = C.stroke; stroke.Thickness = 1; stroke.Transparency = 0.5; stroke.Parent = mod

    local row = Instance.new("Frame")
    row.Size = UDim2.new(1, 0, 0, 32); row.BackgroundTransparency = 1; row.Parent = mod

    local tb = Instance.new("TextButton")
    tb.Size = UDim2.new(1, -60, 1, 0); tb.BackgroundTransparency = 1
    tb.Text = name .. "  [" .. hk .. "]:  OFF"
    tb.TextColor3 = C.text; tb.Font = Enum.Font.GothamBold; tb.TextSize = 12
    tb.TextXAlignment = Enum.TextXAlignment.Left; tb.Parent = row
    local tp = Instance.new("UIPadding"); tp.PaddingLeft = UDim.new(0, 12); tp.Parent = tb

    local ab = Instance.new("TextButton")
    ab.Size = UDim2.new(0, 32, 1, 0); ab.Position = UDim2.new(1, -32, 0, 0)
    ab.BackgroundTransparency = 1; ab.Text = "v"; ab.TextColor3 = C.accent
    ab.Font = Enum.Font.GothamBold; ab.TextSize = 14; ab.Parent = row

    local sub = Instance.new("Frame")
    sub.Size = UDim2.new(1, 0, 0, 0); sub.Position = UDim2.new(0, 0, 0, 32)
    sub.BackgroundTransparency = 1; sub.ClipsDescendants = true
    sub.Visible = false; sub.Parent = mod

    for i, b in ipairs(builders) do b(sub, (i - 1) * 28 + 4) end

    local open = false
    ab.MouseButton1Click:Connect(function()
        open = not open
        if open then
            sub.Visible = true
            TweenService:Create(sub, TweenInfo.new(0.28, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {Size = UDim2.new(1, 0, 0, sh)}):Play()
            TweenService:Create(ab, TweenInfo.new(0.28), {Rotation = 180}):Play()
        else
            TweenService:Create(ab, TweenInfo.new(0.28), {Rotation = 0}):Play()
            local t = TweenService:Create(sub, TweenInfo.new(0.22, Enum.EasingStyle.Quart, Enum.EasingDirection.In), {Size = UDim2.new(1, 0, 0, 0)})
            t.Completed:Connect(function() sub.Visible = false end)
            t:Play()
        end
    end)

    return {
        module = mod, toggleBtn = tb,
        setActive = function(a)
            tb.Text = name .. "  [" .. hk .. "]:  " .. (a and "ON" or "OFF")
            mod.BackgroundColor3 = a and C.active or C.btn
        end,
    }
end

