-- ============ LOGIC ============
local function isAlive()
    local c = player.Character
    if not c then return false end
    local h = c:FindFirstChildOfClass("Humanoid")
    return h and h.Health > 0
end

local function validT(m)
    if not m or not m.Parent then return false end
    local h = m:FindFirstChildOfClass("Humanoid")
    if not h or h.Health <= 0 then return false end
    if S.AimFilter == "Players" and not Players:GetPlayerFromCharacter(m) then return false end
    return true
end

local function validTrig(m)
    if not m or not m.Parent then return false end
    local h = m:FindFirstChildOfClass("Humanoid")
    if not h or h.Health <= 0 then return false end
    if S.TriggerFilter == "Players" and not Players:GetPlayerFromCharacter(m) then return false end
    return true
end

local function getPart(m, part)
    if not m then return nil end
    return m:FindFirstChild(part) or m:FindFirstChild("HumanoidRootPart")
end

local function findTarget(pxRad)
    local mp = UserInputService:GetMouseLocation()
    local mc = player.Character
    local mr = mc and mc:FindFirstChild("HumanoidRootPart")
    if not mr then return nil end
    local best, bd = nil, pxRad
    for _, pl in ipairs(Players:GetPlayers()) do
        if pl ~= player and pl.Character and validT(pl.Character) then
            local p = getPart(pl.Character, S.AimPart)
            if p then
                local wd = (p.Position - mr.Position).Magnitude
                if wd <= S.MaxDistance then
                    local sp, on = camera:WorldToViewportPoint(p.Position)
                    if on then
                        local d = (Vector2.new(sp.X, sp.Y) - mp).Magnitude
                        if d < bd then bd = d; best = pl.Character end
                    end
                end
            end
        end
    end
    if S.AimFilter == "All" then
        for _, o in ipairs(workspace:GetDescendants()) do
            if o:IsA("Model") and o ~= mc then
                local h = o:FindFirstChildOfClass("Humanoid")
                if h and h.Health > 0 and not Players:GetPlayerFromCharacter(o) then
                    local p = getPart(o, S.AimPart)
                    if p then
                        local wd = (p.Position - mr.Position).Magnitude
                        if wd <= S.MaxDistance then
                            local sp, on = camera:WorldToViewportPoint(p.Position)
                            if on then
                                local d = (Vector2.new(sp.X, sp.Y) - mp).Magnitude
                                if d < bd then bd = d; best = o end
                            end
                        end
                    end
                end
            end
        end
    end
    return best
end

local function scrDist(m)
    if not validT(m) then return math.huge end
    local p = getPart(m, S.AimPart)
    if not p then return math.huge end
    local sp, on = camera:WorldToViewportPoint(p.Position)
    if not on then return math.huge end
    return (Vector2.new(sp.X, sp.Y) - UserInputService:GetMouseLocation()).Magnitude
end

local function underCross()
    local c = player.Character
    if not c then return nil end
    local r = camera:ViewportPointToRay(camera.ViewportSize.X/2, camera.ViewportSize.Y/2)
    local p = RaycastParams.new()
    p.FilterType = Enum.RaycastFilterType.Exclude
    p.FilterDescendantsInstances = {c, camera}
    local res = workspace:Raycast(r.Origin, r.Direction * S.TriggerRange, p)
    if not res or not res.Instance then return nil end
    local m = res.Instance:FindFirstAncestorOfClass("Model")
    if m and validTrig(m) then return m end
    return nil
end

