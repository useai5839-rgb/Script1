local lastBuildHeld = false
track(RunService.Heartbeat:Connect(function()
    local held = false
    pcall(function() held = UserInputService:IsKeyDown(S.BuildKey) end)
    if held and not lastBuildHeld and not buildActive then startBuild()
    elseif not held and lastBuildHeld and buildActive then stopBuild() end
    lastBuildHeld = held
end))

track(UserInputService.InputBegan:Connect(function(input, gpe)
    if capturingBuildBind and input.UserInputType == Enum.UserInputType.Keyboard then
        capturingBuildBind = false
        S.BuildKey = input.KeyCode
        if buildBindBtn then buildBindBtn.Text = "Bind:  " .. S.BuildKey.Name; buildBindBtn.BackgroundColor3 = C.btnHover end
        if buildStatus then buildStatus.Text = "Hold " .. S.BuildKey.Name .. " to build" end
        return
    end
    if capturingLeaveBind and input.UserInputType == Enum.UserInputType.Keyboard then
        capturingLeaveBind = false
        S.LeaveKey = input.KeyCode
        if leaveBindBtn then leaveBindBtn.Text = "Bind:  " .. S.LeaveKey.Name; leaveBindBtn.BackgroundColor3 = C.btnHover end
        return
    end
    if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
    if UserInputService:GetFocusedTextBox() then return end

    if input.KeyCode == S.PanelKey then togglePanel()
    elseif input.KeyCode == S.ToggleKey then toggleAim()
    elseif input.KeyCode == S.TriggerKey then toggleTrig()
    elseif input.KeyCode == S.LockKey then toggleLock()
    elseif input.KeyCode == S.ESPKey then toggleEsp()
    elseif input.KeyCode == S.LeaveKey then leaveGame() end
end))

