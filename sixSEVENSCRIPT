    if S.AimEnabled then
        if S.VisualCircle then fovCircle.Visible = true end
        startAim()
    else
        fovCircle.Visible = false
        stopAim()
    end
end

local function toggleTrig()
    S.TriggerEnabled = not S.TriggerEnabled
    if trigMod then trigMod.setActive(S.TriggerEnabled) end
    if S.TriggerEnabled then startTrig() else stopTrig() end
end

